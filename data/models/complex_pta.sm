// =========================================================
// ภาพรวมโจทย์ (Overview): แบบจำลองภารกิจโดรนส่งของ (Complex PTA)
// แบบจำลองนี้จำลองภารกิจโดรนอัตโนมัติภายใต้ระบบเวลาจริง มีขั้นตอนเตรียมตัว, บินไป, ส่งของ, บินกลับ
// ระหว่างทางมี "โอกาสเจอพายุ" (p_weather) ทำให้โดรนต้องเสียเวลาประเมินสถานการณ์
// และหากพยายามบินฝ่าพายุจะมี "ความเสี่ยงที่โดรนตก" (p_crash) นำไปสู่ความล้มเหลว
// เหมาะกับการทำ Parameter Sweep ของ p_weather เพื่อวิเคราะห์โอกาสสำเร็จของภารกิจภายในเวลา 40 นาที
//
// 🎯 คำแนะนำการกำหนด PCTL (Properties):
// 1. Pmax=? [ F<=40 (s=5) ] 
//    ความหมาย: "โอกาสสูงสุด (Max Probability) ที่ภารกิจจะสำเร็จ (s=5) ภายในเวลารวม 40 นาที"
// 2. Pmax=? [ F (s=6) ]
//    ความหมาย: "โอกาสสูงสุดที่โดรนจะพบกับความล้มเหลวหรือตก (s=6)"
// =========================================================
pta

// พารามิเตอร์ โอกาสเจอสภาพอากาศแย่ (เอาไว้ทำ Parameter Sweep)
const double p_weather; 
// โอกาสที่โดรนจะตกเมื่อพยายามฝ่าพายุ
const double p_crash = 0.3; 

module DroneDelivery
    // สถานะของโดรน
    s : [0..6] init 0; 
    // 0 = เตรียมตัว
    // 1 = บินไปส่งของ
    // 2 = เจอพายุ (อากาศแย่)
    // 3 = กำลังส่งของให้ลูกค้า
    // 4 = บินกลับฐาน
    // 5 = สำเร็จภารกิจ (เป้าหมาย)
    // 6 = ล้มเหลว (โดรนตกหรือยกเลิก)
    
    // ตัวแปรนับจำนวนครั้งที่พยายามฝ่าพายุ
    retry : [0..2] init 0; 

    // นาฬิกาจับเวลาในแต่ละขั้นตอน
    t : clock; 

    // กฎบังคับเวลา (Invariant): โดรนจะค้างอยู่ในสถานะต่างๆ ได้นานสุดกี่นาที
    invariant
        (s=0 => t<=5) &          // เตรียมตัวไม่เกิน 5 นาที
        (s=1 => t<=15) &         // บินไปไม่เกิน 15 นาที
        (s=2 => t<=10) &         // ติดพายุไม่เกิน 10 นาที
        (s=3 => t<=5) &          // ส่งของไม่เกิน 5 นาที
        (s=4 => t<=15) &         // บินกลับไม่เกิน 15 นาที
        (s=5 => true) &          // สำเร็จ (ค้างได้ตลอดไป)
        (s=6 => true)            // ล้มเหลว (ค้างได้ตลอดไป)
    endinvariant

    // 1. ออกเดินทาง (ใช้เวลาเตรียมตัวอย่างน้อย 2 นาที แต่ไม่เกิน 5 นาที)
    [depart] s=0 & t>=2 -> 
        (1-p_weather) : (s'=1) & (t'=0) + // ทางสะดวก
        p_weather     : (s'=2) & (t'=0);  // เจอพายุ

    // 2. บินไปถึงเป้าหมายแบบปกติ (ใช้เวลาเดินทาง 10-15 นาที)
    [arrive] s=1 & t>=10 -> 1.0 : (s'=3) & (t'=0);

    // 3. จัดการกับพายุ (รอดูสถานการณ์ 5-10 นาที ก่อนพยายามฝ่าพายุ)
    [fly_storm] s=2 & t>=5 & retry < 2 ->
        (1-p_crash) : (s'=1) & (t'=0) & (retry'=retry+1) + // ฝ่าสำเร็จ บินไปส่งของต่อ
        p_crash     : (s'=6) & (t'=0);                     // ฝ่าไม่สำเร็จ โดรนตก

    // ถ้ารอและลองฝ่ามาครบ 2 ครั้งแล้วยังเจอพายุอีก ให้ยกเลิกภารกิจทันทีเพื่อความปลอดภัย
    [abort_storm] s=2 & t>=5 & retry = 2 -> 1.0 : (s'=6) & (t'=0);

    // 4. ทำการจัดส่งพัสดุ (ใช้เวลา 2-5 นาที)
    [deliver] s=3 & t>=2 -> 1.0 : (s'=4) & (t'=0);

    // 5. บินกลับฐาน (ใช้เวลา 10-15 นาที)
    [return_base] s=4 & t>=10 -> 1.0 : (s'=5) & (t'=0);

endmodule
